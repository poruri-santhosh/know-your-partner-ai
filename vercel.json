{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/", "destination": "/frontend/index.html" },
    { "source": "/quiz", "destination": "/frontend/quiz.html" },
    { "source": "/analysis", "destination": "/frontend/analysis.html" },
    { "source": "/result", "destination": "/frontend/result.html" },
    { "source": "/css/:path*", "destination": "/frontend/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/js/:path*" },
    { "source": "/:file.html", "destination": "/frontend/:file.html" }
  ]
}
